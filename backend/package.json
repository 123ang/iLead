{
  "name": "ilead-backend",
  "version": "0.1.0",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "build": "node --check src/server.js && find src -name '*.js' -maxdepth 5 -print0 | xargs -0 -n1 node --check",
    "lint": "node --check src/server.js",
    "prisma:generate": "prisma generate",
    "seed": "prisma db seed"
  },
  "dependencies": {
    "@prisma/client": "^6.7.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.24.4"
  },
  "devDependencies": { "nodemon": "^3.1.10", "prisma": "^6.7.0" },
  "prisma": { "seed": "node prisma/seed.js" }
}
